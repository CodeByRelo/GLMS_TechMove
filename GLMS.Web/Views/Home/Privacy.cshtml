@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Hero Section -->
<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">@ViewData["Title"]</h1>
    <p class="lead text-muted">
        This page outlines the privacy practices, project details, and compliance notes
        for the Global Logistics Management System (GLMS).
    </p>
</div>

<!-- Project Credits -->
<div class="card shadow-lg border-0 mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-people"></i> Project Contributors</h5>
    </div>
    <div class="card-body">
        <p><strong>Developed By:</strong> Tshwarelo Lephoto (Rosebank College)</p>
        <p><strong>Course:</strong> Advanced Diploma in Application Development</p>
        <p><strong>Purpose:</strong> Academic project demonstrating enterprise‑level application development.</p>
    </div>
</div>

<!-- Privacy Policy -->
<div class="card shadow-lg border-0 mb-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Privacy Practices</h5>
    </div>
    <div class="card-body">
        <ul>
            <li><strong>Data Collection:</strong> Only essential client and contract information is stored for operational purposes.</li>
            <li><strong>Data Usage:</strong> Information is used strictly for service delivery, compliance, and academic demonstration.</li>
            <li><strong>User Rights:</strong> Clients may request data removal or correction in line with POPIA (South Africa) and GDPR (EU) standards.</li>
        </ul>
    </div>
</div>

<!-- Plagiarism & Academic Integrity -->
<div class="card shadow-lg border-0 mb-4">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Plagiarism & Integrity Note</h5>
    </div>
    <div class="card-body">
        <p>
            This project was created for academic purposes. All code, design, and documentation
            are original unless otherwise referenced. External sources are acknowledged in line
            with IEEE citation standards. Plagiarism is strictly prohibited and monitored.
        </p>
    </div>
</div>

<!-- Compliance & Disclaimer -->
<div class="card shadow-lg border-0 mb-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Compliance & Disclaimer</h5>
    </div>
    <div class="card-body">
        <p>
            The GLMS system is an academic demonstration and not intended for production use.
            While project best practices are implemented, the system should not be used for
            handling real financial or client data outside the academic context.
        </p>
    </div>
</div>

<!-- Footer -->
<div class="mt-4 text-muted text-center">
    <small>
        © 2026 Global Logistics Management System (GLMS) — Academic Project, Rosebank College - ST10535591 - Tshwarelo Lephoto.
    </small>
</div>
