@model GLMS.Core.Entities.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<!-- Hero Section -->
<div class="text-center mb-5">
    <h1 class="display-5 fw-bold text-danger">Delete Service Request</h1>
    <p class="lead text-muted">
        You are about to permanently remove this service request from the Global Logistics Management System.
        This action cannot be undone — please review the details carefully before confirming.
    </p>
</div>

<!-- Warning Alert -->
<div class="alert alert-danger text-center fw-semibold">
    ⚠️ Are you sure you want to delete this request?
</div>

<!-- Request Details Card -->
<div class="card shadow-lg border-0 mb-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Request Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3 fw-semibold"><i class="bi bi-hash"></i> Request ID</dt>
            <dd class="col-sm-9">#@Model.Id</dd>

            <dt class="col-sm-3 fw-semibold"><i class="bi bi-file-earmark-text"></i> Contract</dt>
            <dd class="col-sm-9">
                Contract #@Model.Contract?.Id -
                @Model.Contract?.ServiceLevel
                [@Model.Contract?.StartDate.ToString("yyyy-MM-dd")
                to @Model.Contract?.EndDate.ToString("yyyy-MM-dd")]
            </dd>

            <dt class="col-sm-3 fw-semibold"><i class="bi bi-card-text"></i> Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3 fw-semibold"><i class="bi bi-currency-dollar"></i> Cost (USD)</dt>
            <dd class="col-sm-9">@($"${Model.CostUSD:N2}")</dd>

            <dt class="col-sm-3 fw-semibold"><i class="bi bi-cash-stack"></i> Cost (ZAR)</dt>
            <dd class="col-sm-9">@($"R{Model.CostZAR:N2}")</dd>

            <dt class="col-sm-3 fw-semibold"><i class="bi bi-check-circle"></i> Status</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Status == "Pending" ? "bg-warning text-dark" :
                                            Model.Status == "Completed" ? "bg-success" :
                                            "bg-secondary")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3 fw-semibold"><i class="bi bi-calendar-event"></i> Created Date</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToShortDateString()</dd>
        </dl>
    </div>
</div>

<!-- Action Buttons -->
<form asp-action="DeleteConfirmed" method="post" class="text-center">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger btn-lg me-2">
        <i class="bi bi-trash"></i> Confirm Delete
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
        <i class="bi bi-arrow-left"></i> Cancel
    </a>
</form>

<!-- Footer Narrative -->
<div class="mt-4 text-muted text-center">
    <small>
        Deleting a service request will remove all associated records from the system.
        Ensure this action aligns with compliance and operational requirements.
    </small>
</div>
