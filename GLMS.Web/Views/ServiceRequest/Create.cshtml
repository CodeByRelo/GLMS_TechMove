@model GLMS.Core.Entities.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
}

<!-- Hero Section -->
<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Create Service Request</h1>
    <p class="lead text-muted">
        Register a new service request into the Global Logistics Management System.
        Provide accurate details to ensure transparent cost tracking and efficient operations.
    </p>
</div>

<!-- Form Card -->
<div class="card shadow-lg border-0">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-truck"></i> Request Information</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Contract Dropdown -->
            <div class="mb-3">
                <label asp-for="ContractId" class="form-label fw-semibold">
                    <i class="bi bi-file-earmark-text"></i> Contract
                </label>
                <select asp-for="ContractId" class="form-select" asp-items="ViewBag.Contracts">
                    <option value="">-- Select Contract --</option>
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
                <small class="text-muted">
                    Each option shows Contract ID, Client Name, Service Level, and Start/End dates.
                </small>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">
                    <i class="bi bi-card-text"></i> Description
                </label>
                <input asp-for="Description" class="form-control" placeholder="Enter request details" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Cost in USD -->
            <div class="mb-3">
                <label asp-for="CostUSD" class="form-label fw-semibold">
                    <i class="bi bi-currency-dollar"></i> Cost (USD)
                </label>
                <input asp-for="CostUSD" class="form-control" placeholder="e.g. 1200" />
                <span asp-validation-for="CostUSD" class="text-danger"></span>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Save Request
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Footer Narrative -->
<div class="mt-4 text-muted text-center">
    <small>
        Creating service requests in GLMS ensures accurate tracking of logistics operations,
        transparent cost management, and efficient client service delivery.
    </small>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
