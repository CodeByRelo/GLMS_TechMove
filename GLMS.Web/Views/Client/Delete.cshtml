@model GLMS.Core.Entities.Client

@{
    ViewData["Title"] = "Delete Client";
}

<!-- Hero Section -->
<div class="text-center mb-5">
    <h1 class="display-5 fw-bold text-danger">Delete Client</h1>
    <p class="lead text-muted">
        You are about to permanently remove this client from the Global Logistics Management System.
        This action cannot be undone — please review the details carefully before proceeding.
    </p>
</div>

<!-- Warning Alert -->
<div class="alert alert-danger text-center fw-semibold">
    ⚠️ Are you sure you want to delete this client?
</div>

<!-- Client Details Card -->
<div class="card shadow-lg border-0 mb-4">
    <div class="card-header bg-light fw-bold">
        <i class="bi bi-person-circle"></i> Client Information
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Contact</dt>
            <dd class="col-sm-9">@Model.ContactDetails</dd>

            <dt class="col-sm-3">Region</dt>
            <dd class="col-sm-9">@Model.Region</dd>
        </dl>
    </div>
</div>

<!-- Action Buttons -->
<form asp-action="Delete" method="post" class="text-center">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger btn-lg me-2">
        <i class="bi bi-trash"></i> Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary btn-lg">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>

<!-- Footer Narrative -->
<div class="mt-4 text-muted text-center">
    <small>
        Deleting a client will remove all associated records from the system.
        Ensure this action aligns with compliance and operational requirements.
    </small>
</div>
