@model IEnumerable<GLMS.Core.Entities.Contract>
@using GLMS.Core.Enums

@{
    ViewData["Title"] = "Contracts";
}

<!-- HERO -->
<div class="text-center mb-4">
    <h1 class="display-4 fw-bold">Contract Management</h1>
    <p class="text-muted">Review and manage all client contracts in one place.</p>
</div>

<!-- FILTER -->
<div class="card mb-4 shadow border-0">
    <div class="card-body">
        <form asp-action="Search" method="get" class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetNames(typeof(ContractStatus)))
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
            </div>

        </form>
    </div>
</div>

<!-- CREATE -->
<div class="d-flex justify-content-between mb-3">
    <h4>Manage Contracts</h4>
    <a asp-action="Create" class="btn btn-success">+ Create</a>
</div>

<!-- TABLE -->
<div class="card shadow border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Client</th>
                    <th>Service Level</th>
                    <th>Status</th>
                    <th>Start</th>
                    <th>End</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ClientId</td>
                        <td>@item.ServiceLevel</td>

                        <td>
                            <span class="badge
                                @(item.Status == ContractStatus.Active ? "bg-success" :
                                                                    item.Status == ContractStatus.Expired ? "bg-danger" :
                                                                    item.Status == ContractStatus.OnHold ? "bg-warning text-dark" :
                                                                    "bg-secondary")">
                                @item.Status
                            </span>
                        </td>

                        <td>@item.StartDate.ToShortDateString()</td>
                        <td>@item.EndDate.ToShortDateString()</td>

                        <td class="text-center">

                            <!-- BASIC ACTIONS -->
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-info btn-sm">View</a>

                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-outline-warning btn-sm">Edit</a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">Delete</a>

                            @if (!string.IsNullOrEmpty(item.SignedAgreementPath))
                            {
                                <a asp-action="Download"
                                       asp-route-filePath="@item.SignedAgreementPath"
                                       class="btn btn-outline-success btn-sm">
                                    PDF
                                </a>
                            }

                            <hr class="my-2" />

                            <!-- PATCH ACTIONS -->
                            <div class="d-flex gap-1 justify-content-center">

                                <!-- APPROVE -->
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Active" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Approve
                                    </button>
                                </form>

                                <!-- HOLD -->
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="OnHold" />
                                    <button type="submit" class="btn btn-warning btn-sm">
                                        Hold
                                    </button>
                                </form>

                                <!-- EXPIRE -->
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="status" value="Expired" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Expire
                                    </button>
                                </form>

                            </div>

                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>